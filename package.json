{
  "name": "loldrivers-nextjs",
  "version": "1.0.0",
  "type": "module",
  "description": "LOLDrivers Database with SSR and caching",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
