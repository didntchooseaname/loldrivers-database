    "swr": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/memory-cache": "^0.2.6",
    "@types/node": "^25.2.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.12",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@types/react": "^18.3.12",
