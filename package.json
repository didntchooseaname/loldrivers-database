{
  "name": "loldrivers-nextjs",
  "version": "1.0.0",
  "type": "module",
  "description": "LOLDrivers Database with SSR and caching",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "clean": "rimraf .next",
    "update-data": "node scripts/update-data.js",
    "postinstall": "pnpm run type-check"
  },
  "dependencies": {
    "critters": "^0.0.25",
    "memory-cache": "^0.2.0",
    "next": "^16.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.3.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/memory-cache": "^0.2.6",
    "@types/node": "^25.2.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.9",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=25.6.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.12",
      "@types/react-dom": "^18.3.1",
      "entities": "^5.0.0",
      "js-tokens": "^9.0.1",
      "supports-color": "^9.4.0"
    }
  }
}
